# URBANA - Web-GIS Urban Planning & Ecological DSS
# Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL / PostGIS or fallback SQLite-spatialite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbana_gis
SUPABASE_URL=
SUPABASE_KEY=

# Geocoding & OSM Overpass APIs
NOMINATIM_USER_AGENT=urbana-gis-ecological-dss/2.0
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSRM_ROUTING_URL=https://router.project-osrm.org

# Cache & Defaults
CACHE_TTL_HOURS=24
DEFAULT_ROUTING_RADIUS_KM=10
DEFAULT_WALKING_SPEED_KMH=4.5
DEFAULT_DRIVING_SPEED_KMH=35.0
